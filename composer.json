{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",

    "require": {
        "php": "^8.0",
        "aloha/twilio": "^4.0",
        "arcanedev/log-viewer": "^9.0",
        "automattic/woocommerce": "^3.0",
        "barryvdh/laravel-dompdf": "^1.0",
        "composer/semver": "^3.0",
        "consoletvs/charts": "^6.5",
        "giggsey/libphonenumber-for-php": "^8.12",
        "guzzlehttp/guzzle": "^7.8",
        "knox/pesapal": "1.5",
        "laravel/framework": "^9.5",
        "laravel/legacy-factories": "^1.3",
        "laravel/passport": "^11.8",
        "laravel/tinker": "^2.7",
        "laravel/ui": "4.x",
        "laravelcollective/html": "^6.2",
        "league/commonmark": "^2.4.2",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1.48",
        "milon/barcode": "^9.0",
        "mpdf/mpdf": "^8.1",
        "myfatoorah/laravel-package": "*",
        "nunomaduro/collision": "6.4",
        "nwidart/laravel-menus": "dev-master",
        "nwidart/laravel-modules": "^9.0",
        "openai-php/laravel": "^0.4.1",
        "phpseclib/phpseclib": "^3.0.19",
        "pusher/pusher-php-server": "^5.0",
        "razorpay/razorpay": "2.*",
        "setasign/fpdi": "^2.6",
        "spatie/flysystem-dropbox": "^2.0",
        "spatie/laravel-activitylog": "^4.4",
        "spatie/laravel-backup": "^8.0",
        "spatie/laravel-permission": "^5.0",
        "srmklive/paypal": "^3.0",
        "stripe/stripe-php": "^13.0",
        "unicodeveloper/laravel-paystack": "^1.0",
        "yajra/laravel-datatables-oracle": "^9.19"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "knuckleswtf/scribe": "^4.14",
        "mockery/mockery": "^1.4.4",
        "phpunit/phpunit": "9.5",
        "spatie/laravel-ignition": "^1.4"
    },
    
    "autoload": {
        "files": [
            "app/Http/helpers.php"
        ],
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "ocramius/package-versions": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-debugbar"
            ]
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dineshsailor/nWidart-laravel-menus"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
